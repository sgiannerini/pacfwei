+
+## Multivariate partial autocorrelations (Wei)
+changes <- diff(ts(pinkham, start = 1907, frequency = 1))
+pc <- pacf(changes, lag.max = 6, plot = FALSE)
+pr <- pacf(changes, lag.max = 6, plot = FALSE, method = "R")
+stopifnot(isTRUE(all.equal(pc$acf, pr$acf, tolerance = 1e-10)))
+plot(pc)
 }
