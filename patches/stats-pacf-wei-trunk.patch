+pinkham <- structure(list(advertising = c(608L, 451L, 529L, 543L, 525L,
+549L, 525L, 578L, 609L, 504L, 752L, 613L, 862L, 866L, 1016L,
+1360L, 1482L, 1608L, 1800L, 1941L, 1229L, 1373L, 1611L, 1568L,
+983L, 1046L, 1453L, 1504L, 807L, 339L, 562L, 745L, 749L, 862L,
+1034L, 1054L, 1164L, 1102L, 1145L, 1012L, 836L, 941L, 981L, 974L,
+766L, 920L, 964L, 811L, 789L, 802L, 770L, 639L, 644L, 564L),
+    sales = c(1016L, 921L, 934L, 976L, 930L, 1052L, 1184L, 1089L,
+    1087L, 1154L, 1330L, 1980L, 2223L, 2203L, 2514L, 2726L, 3185L,
